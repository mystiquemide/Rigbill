# mainnet or testnet. Testnet uses NEAR testnet, v1.signer-prod.testnet and Bitcoin testnet4.
NETWORK=testnet

# Relayer NEAR account. Any funded account on the chosen network works: the relayer has no special rights.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=

# Optional overrides. Leave unset to use the defaults for NETWORK.
# RIGBILL_CONTRACT=
# MPC_SIGNER=
# NEAR_RPC_URL=
# ESPLORA_URL=
